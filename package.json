{
  "name": "@xanots/auth",
  "version": "0.1.0",
  "description": "Plug-and-play Xano authentication (signup/login/me + user, account, event_log tables) as typed xanots defs — the reference xanots extension package.",
  "type": "module",
  "license": "MIT",
  "author": "Xano",
  "keywords": [
    "xano",
    "xanots",
    "xanoscript",
    "authentication",
    "auth",
    "signup",
    "login",
    "backend",
    "codegen"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/xano-skunkworks/xts-auth.git"
  },
  "homepage": "https://github.com/xano-skunkworks/xts-auth#readme",
  "bugs": {
    "url": "https://github.com/xano-skunkworks/xts-auth/issues"
  },
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "llms.txt"
  ],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "prepublishOnly": "npm run build",
    "release:beta": "npm version prerelease --preid=beta -m \"chore(release): %s\" && npm publish --tag beta --access public"
  },
  "engines": {
    "node": ">=18"
  },
  "peerDependencies": {
    "@xanots/core": "0.0.2-beta.4"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@types/node": "^20.0.0",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "eslint": "^9.0.0",
    "tsup": "^8.0.0",
    "typescript": "^5.5.0",
    "vitest": "^2.0.0",
    "@xanots/core": "0.0.2-beta.4"
  }
}
