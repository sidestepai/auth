{
  "name": "@sidestep/auth",
  "version": "0.4.0",
  "description": "Plug-and-play Xano authentication (signup/login/me + user, account, event_log tables) as typed sidestep defs — the reference sidestep extension package.",
  "type": "module",
  "license": "MIT",
  "author": "Sidestep",
  "keywords": [
    "xano",
    "sidestep",
    "xanoscript",
    "authentication",
    "auth",
    "signup",
    "login",
    "backend",
    "codegen"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sidestepai/auth.git"
  },
  "homepage": "https://github.com/sidestepai/auth#readme",
  "bugs": {
    "url": "https://github.com/sidestepai/auth/issues"
  },
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "llms.txt"
  ],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "tsc --noEmit && vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "fixture:regen": "tsx scripts/regen-golden.ts",
    "prepublishOnly": "npm run build",
    "release": "npm publish --access public",
    "release:beta": "npm version prerelease --preid=beta -m \"chore(release): %s\" && npm publish --tag beta --access public"
  },
  "engines": {
    "node": ">=20"
  },
  "peerDependencies": {
    "@sidestep/core": ">=3.9.25 <5.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@sidestep/core": "4.1.2",
    "@types/node": "^20.0.0",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "eslint": "^9.0.0",
    "tsup": "^8.0.0",
    "tsx": "^4.23.1",
    "typescript": "^5.5.0",
    "vitest": "^2.0.0"
  }
}
